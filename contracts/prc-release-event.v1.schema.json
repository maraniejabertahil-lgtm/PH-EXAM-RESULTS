{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PRC release event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "article_url", "exam_code", "exam_title", "exam_year", "list_type", "content_urls", "detected_at"],
  "properties": {
    "schema_version": {"const": "1"},
    "source_id": {"type": "string", "minLength": 1},
    "article_url": {"type": "string", "pattern": "^https://"},
    "exam_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,30}$"},
    "exam_title": {"type": "string", "minLength": 3},
    "exam_year": {"type": "integer", "minimum": 2000, "maximum": 2100},
    "exam_date": {"type": ["string", "null"]},
    "result_level": {"type": ["string", "null"], "enum": ["elementary", "secondary", null]},
    "list_type": {"enum": ["successful_examinees", "topnotchers", "passers", "other"]},
    "announced_count": {"type": ["integer", "null"], "minimum": 1},
    "content_urls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "format"],
        "properties": {
          "url": {"type": "string", "pattern": "^https://"},
          "format": {"enum": ["pdf", "html", "csv", "json"]},
          "label": {"type": "string"}
        }
      }
    },
    "detected_at": {"type": "string", "minLength": 1}
  }
}
