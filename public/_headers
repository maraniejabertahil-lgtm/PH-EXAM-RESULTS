/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/data/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

/data/site-status.json
  Cache-Control: no-cache, no-store, must-revalidate

/data/*
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400

/assets/*
  Cache-Control: public, max-age=3600
